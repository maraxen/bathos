{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bth-preflight-hook",
            "type": "command"
          }
        ],
        "matcher": "Bash|mcp__.*__submit_job"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bth-session-start-hook",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ]
  }
}