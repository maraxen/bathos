{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bathos.dev/schemas/parity_report.v1.json",
  "title": "Bathos Parity Report Schema v1",
  "type": "object",
  "required": [
    "schema_version",
    "standard_version",
    "record_id",
    "record_sha256",
    "result_sha256",
    "parity_metadata",
    "tool",
    "references",
    "environment",
    "uses",
    "tolerances",
    "waivers",
    "components",
    "cells",
    "waived_cells",
    "not_covered_cells",
    "supplementary",
    "checks_admissibility",
    "consistency_flags",
    "first_divergence",
    "discrepancies",
    "staleness",
    "amendments",
    "audit",
    "provenance",
    "cell_counts",
    "clauses",
    "gates",
    "prior_records_on_pair",
    "evidence_level",
    "bundle_sha256",
    "generator",
    "badge"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "parity_report.v1" },
    "standard_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "record_id": { "type": "string", "minLength": 1 },
    "record_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "result_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "parity_metadata": {
      "type": "object",
      "properties": {
        "reference_self_reported": { "type": "boolean" },
        "weights_attested_only": { "type": "boolean" }
      }
    },
    "tool": { "type": "object", "required": ["name", "repo", "revision", "licence"] },
    "references": { "type": "array" },
    "environment": { "type": "object" },
    "uses": { "type": "array" },
    "tolerances": { "type": "array" },
    "waivers": { "type": "array" },
    "components": { "type": "array" },
    "cells": { "type": "array" },
    "waived_cells": { "type": "array" },
    "not_covered_cells": { "type": "array" },
    "supplementary": { "type": "array" },
    "checks_admissibility": { "type": "array" },
    "consistency_flags": { "type": "array" },
    "first_divergence": {},
    "discrepancies": {},
    "staleness": {},
    "amendments": {},
    "audit": {},
    "provenance": {},
    "cell_counts": { "type": "object" },
    "clauses": { "type": "array" },
    "dual_display_result": { "type": ["object", "null"] },
    "gates": { "type": "array" },
    "prior_records_on_pair": { "type": "integer", "minimum": 0 },
    "evidence_level": { "type": "string", "minLength": 1 },
    "bundle_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "parity_store": {
      "type": "object",
      "required": ["path", "layer"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "layer": { "type": "string", "minLength": 1 }
      }
    },
    "generator": { "type": "object", "required": ["name", "version", "schema"] },
    "badge": {
      "type": "object",
      "required": ["t0", "t1", "t1_sha256", "t2_sha256"]
    }
  }
}
