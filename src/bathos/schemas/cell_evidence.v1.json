{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bathos.dev/schemas/cell_evidence.v1.json",
  "title": "Bathos Parity Cell Evidence Schema v1",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "cell_id",
    "run_id",
    "input_sha256",
    "ours_bundle_sha256",
    "ours_arrays",
    "adapter"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "cell_evidence.v1" },
    "record_id": { "type": "string", "minLength": 1 },
    "cell_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "input_sha256": {
      "type": "object",
      "required": ["ours", "reference"],
      "properties": {
        "ours": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "reference": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "input_transforms": { "type": "array" },
    "ours_bundle_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ours_arrays": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["member_name", "canonical_digest", "dtype", "shape"]
      }
    },
    "reference_bundle_sha256": { "type": ["string", "null"] },
    "reference_arrays": { "type": ["object", "null"] },
    "reference_dump_sha256": { "type": ["string", "null"] },
    "reference_dump_keys": { "type": ["object", "null"] },
    "adapter": {
      "type": "object",
      "required": ["name", "version"]
    },
    "ref_env_blob_sha256": { "type": ["string", "null"] },
    "compared_calls": { "type": "array" },
    "witnesses": { "type": "object" },
    "created_at": { "type": "string" }
  }
}
