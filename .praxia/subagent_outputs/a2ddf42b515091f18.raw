**`~/projects/praxia/crates/praxia-config/src/bin/validate.rs`** (Phase 0, created)
```rust
fn main() {
    let args: Vec<String> = std::env::args().collect();
    if args.len() != 2 { eprintln!("Usage: praxia-manifest-validate <path>"); process::exit(1); }
    let path = std::path::Path::new(&args[1]);
    match Manifest::from_path(path) {
        Ok(m) => { println!("OK: {} v{}", m.plugin.name, m.plugin.version); process::exit(0); }
        Err(e) => { eprintln!("Validation failed:\n{}", e); process::exit(1); }
    }
}
```

